@{
    ViewData["Title"] = "Login";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="card shadow-sm p-4" style="width: 100%; max-width: 400px;">
        <h2 class="text-center mb-4 fw-bold">Admin Login</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger small">@ViewBag.Error</div>
        }

        <form asp-action="Login" method="post">
            <div class="mb-3">
                <label class="form-label">Username</label>
                <input type="text" name="username" class="form-control" required autocomplete="off" />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-dark w-100 mb-2">Login</button>
            <a href="/" class="btn btn-outline-secondary w-100">Back to Portfolio</a>
        </form>
    </div>
</div>S